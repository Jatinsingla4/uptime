# ─── Next.js / Frontend ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8788

# ─── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── D1 Database (replace with your actual DB ID after: wrangler d1 create sitepulse-db) ──
D1_DATABASE_ID=

# ─── Workers Secrets (set via: wrangler secret put JWT_SECRET) ───────────────
JWT_SECRET=change-me-in-production-min-32-chars

# ─── RunPod ───────────────────────────────────────────────────────────────────
RUNPOD_API_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/runsync
RUNPOD_API_KEY=

# ─── Vercel ───────────────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
